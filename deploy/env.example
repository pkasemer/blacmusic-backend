# Copy to /opt/blacmusic/.env on the server (deploy/provision.sh generates one with random secrets).
# Never commit the real file.

TAG=latest

# Secrets (random, generated once)
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-characters-long
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me

# Addresses clients use
PUBLIC_API_URL=https://blacmusic.pkasemer.com
S3_PUBLIC_ENDPOINT=media.blacmusic.pkasemer.com
S3_PUBLIC_USE_SSL=true

# "production" refuses to start without SMTP_HOST (verification emails). Until a mail
# provider is chosen, "development" runs the same code but writes verification codes to
# the API log (docker compose logs api) instead of emailing them.
APP_ENV=development

# Free storage per artist. Keep this small on a shared small disk.
FREE_STORAGE_GB=1

# Email (any SMTP provider with STARTTLS on port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Blac Music <no-reply@blacmusic.pkasemer.com>
