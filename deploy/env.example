# Copy to /opt/blacmusic/.env on the server (deploy/provision.sh generates one with random secrets).
# Never commit the real file.

TAG=latest

# Secrets (random, generated once)
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-characters-long
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me

# Addresses clients use
PUBLIC_API_URL=https://blacmusic.pkasemer.com
S3_PUBLIC_ENDPOINT=blacmedia.pkasemer.com
S3_PUBLIC_USE_SSL=true

# "production" refuses to start without SMTP_HOST (verification emails). Until a mail
# provider is chosen, "development" runs the same code but writes verification codes to
# the API log (docker compose logs api) instead of emailing them.
APP_ENV=development

# Free storage per artist. Keep this small on a shared small disk.
FREE_STORAGE_GB=1

# Email (any SMTP provider with STARTTLS on port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Blac Music <no-reply@blacmusic.pkasemer.com>

# --- YouTube connect (artist onboarding). Leave empty to keep the feature off. ---
# Create an OAuth client (type: web application) in Google Cloud, enable "YouTube Data API v3",
# and add the redirect URI below. Only the read-only scope is requested.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URL=https://blacmusic.pkasemer.com/v1/integrations/youtube/callback
# Where the browser goes after connecting (the app's deep link):
# YOUTUBE_APP_REDIRECT=blacmusic://youtube/connected
# Encrypts stored Google tokens: 64 hex characters (openssl rand -hex 32). Required when GOOGLE_CLIENT_ID is set.
TOKEN_ENC_KEY=
# How many transfers are worked on at once (the server has one core, keep it at 1).
TRANSFER_CONCURRENCY=1

# --- Sign in with Apple / Google ---
# Apple: the app ids whose identity tokens we accept. Needs "Sign in with Apple" enabled on both app ids in the Apple Developer account.
# APPLE_BUNDLE_IDS=com.blac.music,com.blac.music.dev
# Google: an OAuth client of type "Web application" (a separate one from the YouTube client is cleaner) with the redirect URI
# https://blacmusic.pkasemer.com/v1/auth/google/callback . Only the openid, email and profile scopes are used (no Google review needed).
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
# GOOGLE_AUTH_REDIRECT_URL=https://blacmusic.pkasemer.com/v1/auth/google/callback
# GOOGLE_AUTH_APP_REDIRECT=blacmusic://auth/google

# --- Push notifications (through Expo; nothing to configure for it to work) ---
# Only if you switch on "Enhanced push security" in the Expo project settings: an Expo access token.
EXPO_ACCESS_TOKEN=

# --- Privacy Policy and Terms pages (https://<host>/privacy and /terms) ---
# Who runs the service, and the contact address printed on both pages (Google and the app stores ask for one).
# LEGAL_OPERATOR=Blac Music
LEGAL_CONTACT_EMAIL=

# --- Email through Plunk (https://www.useplunk.com) ---
# The secret key (starts with sk_) from the Plunk dashboard, Settings > API Keys. Never the public key (pk_).
# The domain of MAIL_FROM must be verified in Plunk (DNS records) or Plunk refuses to send.
PLUNK_API_KEY=
# The administrator account that owns the editorial playlists edited in the admin site (it must exist and have role admin).
EDITORIAL_OWNER_EMAIL=

# Bulk catalogue import. ADMIN_SITE_URL is only used for the links in import answers.
ADMIN_SITE_URL=
IMPORT_MAX_TOTAL_MB=1024
IMPORT_MIN_FREE_GB=2
# MAIL_FROM=Blac Music <no-reply@pkasemer.com>

# --- Import audio from an artist's own YouTube videos (yt-dlp in the worker) ---
# Off by default. When true, a transfer may fetch the audio-only stream of videos of the channel the artist connected,
# after they confirm they own the rights; songs that cannot be fetched fall back to a file the artist uploads.
# This goes beyond the read-only YouTube API: it can conflict with YouTube's Terms of Service and with Google's review
# of the YouTube permission, and YouTube may block a server's address. The privacy policy and terms change with it.
YOUTUBE_AUDIO_FETCH=false

