# Copy to .env for running the API outside Docker (go run ./cmd/api).
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://blac:blac@localhost:5432/blac?sslmode=disable
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=localhost:9000
# S3_PUBLIC_ENDPOINT=localhost:9000   # host mobile clients use in presigned URLs
S3_REGION=us-east-1
S3_ACCESS_KEY=blacminio
S3_SECRET_KEY=blacminio-secret
S3_BUCKET=blac-media
S3_USE_SSL=false

# Required (32+ chars) when APP_ENV=production.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PLAYBACK_URL_TTL=1h
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW=1m

# Uploads and the transcoding worker (cmd/worker; needs ffmpeg and ffprobe on PATH)
UPLOAD_MAX_MB=2048
UPLOAD_URL_TTL=1h
MAX_TRACK_DURATION=4h
TRANSCODE_TIMEOUT=30m
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL=2s
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Podcasts
FEED_REFRESH_INTERVAL=1h
FEED_FETCH_TIMEOUT=15s
# Dev only (refused when APP_ENV=production): allow feeds on private/loopback addresses.
# FEED_ALLOW_PRIVATE=true

# Artist mode
FREE_STORAGE_GB=10
# Part size of resumable uploads (5-512 MB; files over twice this size use them).
UPLOAD_PART_MB=8
# Base URL apps use to reach the API (image links). Android emulator: http://10.0.2.2:8080
PUBLIC_API_URL=http://localhost:8080
# Verification email. Leave SMTP_HOST empty in development: codes are written to the log instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Blac Music <no-reply@example.com>
